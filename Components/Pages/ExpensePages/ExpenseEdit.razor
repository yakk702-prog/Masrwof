@page "/expense/edit/{id:guid}"
@inject IExpenseService ExpenseService
@inject ICategoryService CategoryService
@inject NavigationManager Navigation

<div class="expense-form-container">
    <EditForm Model="@expense" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator/>
        <div class="expense-form-group">
            <label class="expense-form-label">المصروف</label>
            <input type="text" class="expense-form-input" @bind-value="expense.Name" required/>
        </div>
        <div class="expense-form-group">
            <label class="expense-form-label">المبلغ(د.ل)</label>
            <input type="number" step="0.01" class="expense-form-input" @bind-value="expense.Amount" required/>
        </div>
        <div class="expense-form-group"> 
            <label class="expense-form-label">الفئة</label>
            <select class="expense-form-input" value="@expense.Category" @onchange="OnCategoryChange">
            @foreach (var category in categories)
                {
                    <option value="@category.Name">@category.Name</option>
                }
                
                <option value="Add_New">أخرى</option>
            </select>
        </div>
        <div class="expense-form-group">
            <label class="expense-form-label">التاريخ</label>
            <input type="date" class="expense-form-input" @bind-value="expense.Date" />
        </div>
        <div class="expense-actions">
            <button type="submit" class="expense-btn expense-btn-primary">حفظ</button>
            <button type="button" class="expense-btn" @onclick='GoBack'>إلغاء</button>
        </div>
    </EditForm>
</div>
@code {
    [Parameter]
    public Guid Id { get; set; }
    [SupplyParameterFromQuery]
    public string? SelectedCategory { get; set; }
    private Expense expense = new();
    private List<Category> categories = new();
    protected override void OnInitialized()
    {
        expense = ExpenseService.GetExpenseById(Id) ?? new();
        categories = CategoryService.GetAllCategories();
        if (expense.Id == Guid.Empty)
        {
            Navigation.NavigateTo("/expensesList");
            return;
        }
        if (!string.IsNullOrWhiteSpace(SelectedCategory))
        {
            expense.Category = SelectedCategory;
        }
        else if (string.IsNullOrWhiteSpace(SelectedCategory) && categories.Any())
        {
            expense.Category = categories.First().Name;
        }
    }
    private void OnCategoryChange(ChangeEventArgs e)
    {
        var selectedCategory = e.Value?.ToString()??string.Empty;
        if (selectedCategory=="Add_New")
        {
            var returnUrl = Uri.EscapeDataString($"/expense/edit/{Id}");  
            Navigation.NavigateTo($"/category/add?returnUrl={returnUrl}");
            return;
        }
        expense.Category = selectedCategory;
    }
    private void HandleSubmit()
    {
        ExpenseService.UpdateExpense(expense);
        GoBack();
    }
    private void GoBack() => Navigation.NavigateTo("/expensesList");
}
