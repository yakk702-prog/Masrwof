@page "/categorieslist"

@inject ICategoryService CategoryService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4" dir="rtl" style="text-align: right;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">سجل الفئات</h2>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/category/add")'>إضافة فئة</button>
    </div>

    <p class="mb-3"><strong>إجمالي الفئات</strong> @CategoryService.GetTotalCategoryAmount().ToString("C2", CultureInfo.GetCultureInfo("ar-LY"))</p>

    @if (!categories.Any())
    {
        <p class="text-muted">لا توجد فئات مسجلة.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm text-center align-middle">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الفئة</th>
                        <th>المبلغ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in categories)
                    {
                        <tr>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>@item.Name</td>
                            <td>@item.Amount.ToString("C2", CultureInfo.GetCultureInfo("ar-LY"))</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" @onclick='() => Navigation.NavigateTo($"/category/view/{item.Id}")'>عرض</button>
                                <button class="btn btn-sm btn-outline-primary mx-1" @onclick='() => Navigation.NavigateTo($"/category/edit/{item.Id}")'>تعديل</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick='() => DeleteCategory(item.Id)'>حذف</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Category> categories = new();

    protected override void OnInitialized()
    {
        LoadCategories();
    }
    private void LoadCategories()
    {
        categories = CategoryService.GetAllCategories();
    }
    private async Task DeleteCategory(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد أنك تريد حذف هذه الفئة؟");
        if (!confirmed)
        {
            return;
        }
        CategoryService.DeleteCategory(id);
        LoadCategories();
    }
}
